# ---- Dashboard ----
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me            # required when NODE_ENV=production
# DATA_DIR=./data                   # SQLite DB, source images, generated posters, logo

# ---- Facebook Graph API (see docs/FACEBOOK_ACCESS.md) ----
FB_APP_ID=
FB_APP_SECRET=
FB_USER_ACCESS_TOKEN=               # system-user token with pages_show_list + pages_read_engagement
# FB_PAGE_ACCESS_TOKENS={"<page id or username>":"<page token>"}
FB_GRAPH_VERSION=v23.0
FB_PPCA_APPROVED=false              # true only after Meta approves Page Public Content Access
# FB_POSTS_PER_POLL=25

# ---- Text extraction ----
ANTHROPIC_API_KEY=                  # leave empty to type poster text manually
# EXTRACTION_PROVIDER=anthropic     # anthropic | manual (defaults to anthropic when a key is set)
# ANTHROPIC_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=medium

# ---- Worker ----
# DEFAULT_POLL_INTERVAL_MINUTES=10  # initial value; change it in the dashboard
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_BASE_SEC=30
# DUPLICATE_HAMMING_THRESHOLD=6
# DUPLICATE_WINDOW_DAYS=14
